# Copy to .env on your own deployment. Keep .env out of Git.
# Empty values below are placeholders, never working credentials.
HELICRAFT_SMTP_USER=
HELICRAFT_SMTP_PASS=
HELICRAFT_SMTP_HOST=smtp.example.org
# Generate a fresh random value of at least 32 characters for your deployment.
HELICRAFT_AI_SESSION_SECRET=
# Optional Jack provider configuration; use your own API key and model ID.
HELICRAFT_AI_BASE_URL=https://api.deepseek.com
HELICRAFT_AI_API_KEY=
HELICRAFT_AI_MODEL=
# Local development only; use 1 for HTTPS production deployment.
HELICRAFT_AI_COOKIE_SECURE=0
HELICRAFT_AI_PUBLIC_ORIGIN=http://127.0.0.1:8081
